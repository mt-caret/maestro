# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "OxCaml implementation of the Symphony coding-agent orchestration service"
description:
  "A daemon that polls an issue tracker, creates isolated per-issue workspaces, and drives Codex app-server coding-agent sessions, per the Symphony specification (github.com/openai/symphony). Includes a Linear tracker adapter, an HTTP observability API, and an interactive bonsai_term terminal dashboard."
maintainer: ["mtakeda@oeconomia.jp"]
authors: ["Masayuki Takeda"]
license: "Apache-2.0"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.17"}
  "core"
  "core_unix"
  "async"
  "ppx_jane"
  "jsonaf"
  "ppx_jsonaf_conv"
  "yaml"
  "cohttp"
  "cohttp-async"
  "async_ssl"
  "uri"
  "sha"
  "bonsai"
  "bonsai_term"
  "ppx_tydi" {with-test}
  "bonsai_term_test" {with-test}
  "expect_test_helpers_core" {with-test}
  "expect_test_helpers_async" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
